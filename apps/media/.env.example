# メディアサイトのビルド時環境変数(静的エクスポート時にHTMLへ埋め込まれる)。
# 本番ビルド前に .env.local などで設定する。未設定でもビルドは通り、該当機能が無効になるだけ。

# GA4 計測ID。設定するとgtagが読み込まれ、イベント計測(docs/media/08)が有効化される。
# 例: G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=

# 相談CVの実チャネルURL(既存クリニックの予約・LINE)。設定すると相談ページに導線が表示される。
# 未設定の場合は電話導線のみ表示され、「公開時に有効化」と注記される。
NEXT_PUBLIC_RESERVE_URL=
NEXT_PUBLIC_LINE_URL=
