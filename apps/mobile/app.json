{
  "expo": {
    "name": "MIRAI LINK",
    "slug": "mirai-link",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "jp.co.medident.mirailink",
      "appleTeamId": "RCNX8548N2",
      "entitlements": {
        "com.apple.developer.push-to-talk": true,
        "aps-environment": "development"
      },
      "infoPlist": {
        "NSMicrophoneUsageDescription": "院内インカムで通話するためにマイクを使用します。",
        "NSBluetoothAlwaysUsageDescription": "BLEリモコン（ボタン）で送信を開始/停止するためにBluetoothを使用します。",
        "UIBackgroundModes": [
          "audio",
          "push-to-talk",
          "bluetooth-central"
        ]
      }
    },
    "android": {
      "package": "jp.co.medident.mirailink",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MICROPHONE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.WAKE_LOCK"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "@livekit/react-native-expo-plugin",
      "@config-plugins/react-native-webrtc"
    ],
    "extra": {
      "eas": {
        "projectId": "656799af-e44c-4ace-9dd0-31f173a1be08"
      }
    },
    "owner": "tomyorts"
  }
}
